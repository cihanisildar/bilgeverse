  @@index([organizationId])
}

// Rehberlerin alması gereken eğitim programları (A, B, C ...)
model TutorTrainingProgram {
  id          String                @id @default(uuid())
  name        String
  description String?
  orderIndex  Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  records     TutorTrainingRecord[] @relation("ProgramRecords")

  // --- multi-tenant ---
  organizationId String @default("__NO_ORG__")

  @@index([organizationId])
}

// Hangi rehberin hangi eğitimi aldığı + yönetim notu
model TutorTrainingRecord {
  id          String               @id @default(uuid())
  programId   String
  tutorId     String
  completed   Boolean              @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  program     TutorTrainingProgram @relation("ProgramRecords", fields: [programId], references: [id], onDelete: Cascade)
  tutor       User                 @relation("TutorTrainingRecords", fields: [tutorId], references: [id], onDelete: Cascade)

  // --- multi-tenant ---
  organizationId String @default("__NO_ORG__")

  @@unique([programId, tutorId])
  @@index([tutorId])
  @@index([organizationId])
}
